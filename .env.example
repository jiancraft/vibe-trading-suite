# ============================================================================
# Vibe-Trading Suite 环境变量配置模板 (.env.example)
# 复制本文件为 .env 并填入您自己的真实配置即可运行。
# ============================================================================

# ----------------------------------------------------------------------------
# 1. AI 大模型提供商配置 (用户自填，绝无内置密钥)
# ----------------------------------------------------------------------------
# 推荐使用的模型 Provider (deepseek / openai / gemini / openrouter / anthropic)
LANGCHAIN_PROVIDER=deepseek
LANGCHAIN_MODEL_NAME=deepseek-chat

# DeepSeek 官方 API 配置 (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI 官方 API 配置 (https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini API 配置 (https://ai.google.dev)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Anthropic Claude API 配置 (https://console.anthropic.com)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenRouter 统一网关配置 (https://openrouter.ai)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# ----------------------------------------------------------------------------
# 2. 加密货币实盘交易所配置 (可选，仅用于实盘或行情私有接口)
# ----------------------------------------------------------------------------
# OKX 官方 API (请务必在 OKX 开启 IP 白名单并关闭提现权限)
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here
OKX_PASSPHRASE=your_okx_passphrase_here
# 模拟盘开关: 默认为 true (模拟盘环境)，实盘前建议充分模拟测试后再切换为 false
OKX_IS_SIMULATED=true

# ----------------------------------------------------------------------------
# 3. 消息推送通知配置 (可选)
# ----------------------------------------------------------------------------
# Telegram 战报机器人推送
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ----------------------------------------------------------------------------
# 4. Web 控制台、安全鉴权与网络绑定
# ----------------------------------------------------------------------------
PORT=8899
# 网络绑定地址: 本地环境默认为 127.0.0.1 (仅本机可访，绝不向局域网或公网暴露)
# 云端 VPS 如需直接公网访问可设为 0.0.0.0 (强烈建议前置 Nginx/Caddy 反向代理并配置 SSL)
BIND_ADDR=127.0.0.1

# 控制台与 API 强鉴权口令 (必填，禁止为空或保留占位符，长度建议 >= 24 位)
# 生成高强度口令命令: openssl rand -hex 24
API_AUTH_KEY=your_custom_api_auth_key_here
VIBE_TRADING_HOME=/home/vibe/.vibe-trading
